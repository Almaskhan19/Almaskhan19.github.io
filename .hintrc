{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "meta[name=theme-color]"
        ]
      }
    ],
    "no-inline-styles": "off",
    "axe/keyboard": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_ff <= 157",
    "not firefox <= 157",
    "not opera <= 135"
  ]
}